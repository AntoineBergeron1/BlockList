[flake8]
max-line-length = 88
max-complexity = 18
exclude =
    .git,
    __pycache__,
    */migrations/*,
    */node_modules/*,
    venv,
    .venv,
    env,
    build,
    dist,
    .eggs,
    *.egg-info

# Ignorer les erreurs spécifiques pour compatibilité avec black
ignore =
    E203,
    E266,
    E501,
    W503,
    F403,
    F401
