[flake8]
max-line-length = 88
max-complexity = 18
exclude =
    .git,
    __pycache__,
    */migrations/*,
    */node_modules/*,
    venv,
    .venv,
    env,
    build,
    dist,
    .eggs,
    *.egg-info

# Ignorer les erreurs spécifiques pour compatibilité avec black
ignore =
    E203,  # whitespace before ':'
    E266,  # too many leading '#' for block comment
    E501,  # line too long (handled by black)
    W503,  # line break before binary operator
    F403,  # 'from module import *' used
    F401,  # imported but unused (souvent faux positifs)
